# Go
*.exe
*.dll
*.so
*.dylib
*.test
*.out
/bin/
/dist/
vendor/

# Local chain / index data — never commit
/data/
*.db
*.sqlite
blindbit.toml
bitcoin.conf

# Secrets — never commit
# canary-indexer keeps its signing key at ~/.canary/indexer.key by default.
# *.key covers the file anywhere; .canary/ covers the directory if a checkout
# ever holds one.
.canary/
*.key
*.pem
.env
.env.*
!.env.example
nsec*

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Scratch
/tmp/
/scratch/

# Output of scripts/demo-regtest.sh: state file, evidence files, logs
demo-out/

# UI screenshots from design reviews
/.ui-screens/

# Browser automation logs and page snapshots from design reviews
/.playwright-mcp/

# Public site output, built by go run ./cmd/site
/site/dist/

# Binaries built at the repository root by the README commands
/canary
/canary-indexer
/canary-uidev
