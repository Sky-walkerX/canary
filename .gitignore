# Go
*.exe
*.dll
*.so
*.dylib
*.test
*.out
/bin/
/dist/
vendor/

# Local chain / index data — never commit
/data/
*.db
*.sqlite
blindbit.toml
bitcoin.conf

# Secrets — never commit
# canary-indexer keeps its signing key at ~/.canary/indexer.key by default.
# *.key covers the file anywhere; .canary/ covers the directory if a checkout
# ever holds one.
.canary/
*.key
*.pem
.env
.env.*
!.env.example
nsec*

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Scratch
/tmp/
/scratch/

# UI screenshots from design reviews
/.ui-screens/

# Playwright MCP session files
/.playwright-mcp/
